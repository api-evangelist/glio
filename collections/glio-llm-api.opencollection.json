{
  "opencollection": "1.0.0",
  "info": {
    "name": "Glio Jobs LLM API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "LLM",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create chat completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.glio.io/v1/chat/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "OpenAI-compatible chat completions endpoint."
        },
        {
          "info": {
            "name": "Create embeddings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.glio.io/v1/embeddings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "OpenAI-compatible embeddings endpoint."
        }
      ]
    }
  ],
  "bundled": true
}